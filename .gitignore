# 构建产物
*.exe
bin/
command-runtime/
command-work/

# 运行日志（serve.ps1 / reload-sump.ps1 落盘处，不入库）
logs/

# 本地配置（密钥等，不入库）
local.yaml
local.*.yaml

# 本地数据（记忆库等，不入库）
data/
*.db

# 前端服务（Node）：依赖与构建产物不入库
frontend/node_modules/
frontend/dist/
frontend/design/specimen-assets/

# embedding 服务（Python）：虚拟环境 / 缓存 / 构建元数据不入库
embedding/.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# 编辑器统计（VS Code Counter 之类）——本地产物，不入库
.VSCodeCounter/
