# 构建产物
# 打包产物（automation/package.ps1 输出）
dist/
*.exe
bin/
command-runtime/
command-work/

# 运行日志（serve.ps1 / reload-sump.ps1 落盘处，不入库）
logs/

# 本地配置（密钥等，不入库）
local.yaml
local.*.yaml

# 本地数据（记忆库等，不入库）
data/
*.db

# 前端服务（Node）：依赖与构建产物不入库
src/frontend/node_modules/
src/frontend/dist/
src/frontend/design/specimen-assets/

# embedding 服务（Python）：虚拟环境 / 缓存 / 构建元数据不入库
src/embedding/.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# 编辑器统计（VS Code Counter 之类）——本地产物，不入库
.VSCodeCounter/

# 本地工具/实验生成物（不入库）
.qoder/
experiments/bp-build/
experiments/pitch-narrative-playbook.md

# 商业计划书等非项目产物，防止误提交
SUMP-*.pdf
